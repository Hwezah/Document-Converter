<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- WatchHub's near-black page behind the web view, so launch never flashes white. -->
    <style name="Theme.Folio" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
    <color name="ink">#0A0A0A</color>
    <color name="red">#B81D24</color>
</resources>
